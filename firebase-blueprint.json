{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "Paper": {
      "title": "Paper",
      "description": "Uploaded paper metadata and extracted content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 500 },
        "authors": { "type": "string", "maxLength": 500 },
        "year": { "type": "string", "maxLength": 10 },
        "abstract": { "type": "string", "maxLength": 10000 },
        "fileName": { "type": "string", "maxLength": 255 },
        "fileSize": { "type": "number" },
        "pageCount": { "type": "number" },
        "storageUrl": { "type": "string", "maxLength": 2048 },
        "extractedText": { "type": "string", "maxLength": 200000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "fileName", "createdAt"]
    },
    "Summary": {
      "title": "Summary",
      "description": "Paper summary breakdown",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paperId": { "type": "string" },
        "paperTitle": { "type": "string", "maxLength": 500 },
        "objectives": { "type": "string", "maxLength": 10000 },
        "methodology": { "type": "string", "maxLength": 10000 },
        "keyFindings": { "type": "string", "maxLength": 15000 },
        "limitations": { "type": "string", "maxLength": 10000 },
        "conclusions": { "type": "string", "maxLength": 10000 },
        "fullSummaryText": { "type": "string", "maxLength": 50000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "paperId", "paperTitle", "createdAt"]
    },
    "Abstract": {
      "title": "Abstract",
      "description": "Generated academic abstract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paperId": { "type": "string" },
        "paperTitle": { "type": "string", "maxLength": 500 },
        "generatedAbstract": { "type": "string", "maxLength": 10000 },
        "keywords": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "paperId", "paperTitle", "generatedAbstract", "createdAt"]
    },
    "LiteratureReview": {
      "title": "LiteratureReview",
      "description": "Synthesized multi-paper literature review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "reviewTitle": { "type": "string", "maxLength": 500 },
        "synthesis": { "type": "string", "maxLength": 50000 },
        "commonThemes": { "type": "string", "maxLength": 20000 },
        "conflictingFindings": { "type": "string", "maxLength": 20000 },
        "citations": { "type": "string", "maxLength": 20000 },
        "paperTitles": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "reviewTitle", "synthesis", "createdAt"]
    },
    "ResearchGap": {
      "title": "ResearchGap",
      "description": "Identified research gaps and novel directions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "topic": { "type": "string", "maxLength": 500 },
        "limitations": { "type": "string", "maxLength": 20000 },
        "unansweredQuestions": { "type": "string", "maxLength": 20000 },
        "underexploredAreas": { "type": "string", "maxLength": 20000 },
        "novelTopics": { "type": "string", "maxLength": 30000 },
        "paperTitles": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "topic", "novelTopics", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Research assistant conversation history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "paperId": { "type": "string", "maxLength": 100 },
        "paperTitle": { "type": "string", "maxLength": 500 },
        "messagesJson": { "type": "string", "maxLength": 200000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "messagesJson", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/papers/{paperId}": {
      "schema": "Paper",
      "description": "Uploaded paper documents and text content"
    },
    "/summaries/{summaryId}": {
      "schema": "Summary",
      "description": "Generated paper summaries"
    },
    "/abstracts/{abstractId}": {
      "schema": "Abstract",
      "description": "Generated academic abstracts"
    },
    "/literatureReviews/{reviewId}": {
      "schema": "LiteratureReview",
      "description": "Synthesized multi-paper reviews"
    },
    "/researchGaps/{gapId}": {
      "schema": "ResearchGap",
      "description": "Identified research gaps and potential topics"
    },
    "/chatSessions/{chatId}": {
      "schema": "ChatSession",
      "description": "Chat sessions with the research assistant"
    }
  }
}
